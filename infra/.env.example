# Copy to infra/.env and replace every value. infra/.env is git-ignored; never commit real secrets.
POSTGRES_PASSWORD=change-me-postgres
MIGRATOR_PASSWORD=change-me-migrator
RUNTIME_PASSWORD=change-me-runtime
# Interface the API listens on. 0.0.0.0 = reachable from your LAN (phone pilot); 127.0.0.1 = this machine only.
API_BIND=0.0.0.0
API_PORT=8000
DB_PORT=5432
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=false
